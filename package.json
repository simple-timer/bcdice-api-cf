{
	"name": "bcdice-api-cf",
	"type": "module",
	"scripts": {
		"dev": "bun run check && wrangler dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"postinstall": "find node_modules/bcdice -name '*.map' -type f -delete",
		"check": "bunx biome check"
	},
	"dependencies": {
		"bcdice": "^4.9.0",
		"hono": "^4.12.18"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/node": "^25.6.2",
		"wrangler": "^4.90.0"
	}
}
